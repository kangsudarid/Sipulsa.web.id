[TEMPLATE]
[TEMPLATE]
# ---------------------------------------------------------------------------
# Sipulsa web app (fill these in for production)
# ---------------------------------------------------------------------------

# Public production URL. Used for <link rel="canonical">, sitemap.xml, robots.txt
# and Open Graph / Twitter card URLs.
NEXT_PUBLIC_SITE_URL="https://www.sipulsa.web.id"

# Customer-care WhatsApp number used in the checkout confirmation links.
# Accepts a local (08...) or international (628...) format.
NEXT_PUBLIC_WHATSAPP="081357266414"

# Public contact email shown to customers.
NEXT_PUBLIC_CONTACT_EMAIL="hi@sipulsa.web.id"

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co. Only the URL is public.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Server-only service_role key. Bypasses row level security, so it must never
# be exposed to the browser: do NOT prefix it with NEXT_PUBLIC_.
# Required at runtime: the server is the only thing that talks to the database.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Admin console --------------------------------------------------------
# Password required to open /admin. Pick a long, unique value.
ADMIN_PASSWORD="<strong-admin-password>"

# Random string used to sign the admin session cookie (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="<random-64-hex-chars>"
